# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase.
# URL: Project Settings > Data API (ou Connect).
# Chave: Project Settings > API Keys > "Publishable key" (começa com sb_publishable_).
# NUNCA use aqui a "Secret key" (sb_secret_...) — ela ignora o RLS e não pode ir para o navegador.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
